{
  "name": "mfe-me",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "rsbuild dev",
    "dev:harness": "ME_HARNESS=1 rsbuild dev",
    "dev:mock-iam": "node dev/mock-iam/server.ts",
    "build": "tsc && node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && rsbuild build && node config/remote-manifest-entry.mjs",
    "test": "rstest run",
    "test:unit": "rstest run test/unit",
    "test:integration": "rstest run test/integration",
    "test:e2e": "rstest run test/e2e",
    "test:coverage": "rstest run --coverage",
    "test:ci": "rstest run --coverage && node .github/scripts/coverage-gate.mjs",
    "hooks:install": "node scripts/install-hooks.mjs",
    "preview": "rsbuild preview",
    "lint": "eslint .",
    "arch-lint": "depcruise src --config .dependency-cruiser.cjs",
    "test:browser": "npm run build && playwright test",
    "contracts:check": "node scripts/contracts.mjs check",
    "contracts:pin": "node scripts/contracts.mjs pin",
    "test:contract": "rstest run test/contract",
    "test:smoke": "rstest run --config rstest.smoke.config.ts",
    "budget": "node .github/scripts/bundle-budget.mjs"
  },
  "devDependencies": {
    "@bcbp-solutions-fzc-llc/eslint-plugin": "1.0.0-alpha.10",
    "@bcbp-solutions-fzc-llc/frontend-sdk": "1.0.0-alpha.10",
    "@bcbp-solutions-fzc-llc/webpack-preset": "1.0.0-alpha.10",
    "@opentelemetry/api": "1.10.0",
    "@playwright/test": "1.64.1",
    "@rsbuild/core": "^2.3.1",
    "@rsbuild/plugin-react": "^2.1.1",
    "@rstest/core": "^0.12.6",
    "@rstest/coverage-istanbul": "^0.12.6",
    "@tailwindcss/postcss": "^4.3.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@~7.0.2",
    "ajv": "^8.20.0",
    "axe-core": "^4.14.0",
    "daisyui": "^5.7.50",
    "dependency-cruiser": "18.7.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.1",
    "yaml": "^2.9.1"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@tanstack/react-query": "^5.100.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.5"
  },
  "peerDependencies": {
    "@bcbp-solutions-fzc-llc/frontend-sdk": "^1.0.0-alpha.10"
  },
  "overrides": {
    "minimatch": "^11.0.4",
    "happy-dom": "$happy-dom"
  }
}
